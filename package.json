{
  "name": "carecast-workspace",
  "version": "1.0.0",
  "description": "CareCast development workspace",
  "scripts": {
    "start": "npm-run-all --parallel start:api start:webapp",
    "start:api": "cd care-cast-api && npm run dev",
    "start:webapp": "cd care-cast-webapp && cross-env VITE_API_URL=http://localhost:8080/api npm run dev"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "react-quill": "^2.0.0"
  }
}
